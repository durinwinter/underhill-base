AIRLOCK_HTTP_PORT=8080
AIRLOCK_OPCUA_PORT=4841
ECLSS_OPCUA_PORT=4842
SABATIER_OPCUA_PORT=4843
POWERGRID_OPCUA_PORT=4844
THERMAL_OPCUA_PORT=4845
AIRLOCK_OPCUA_BIND_HOST=0.0.0.0
# Set to this machine's LAN IP for remote UAExpert access (auto-detected if unset)
#AIRLOCK_OPCUA_HOST=192.168.1.100
AIRLOCK_OPCUA_ENDPOINT_PATH=/underhill/airlock
#AIRLOCK_OPCUA_ENDPOINT_URL=opc.tcp://192.168.1.100:4841/underhill/airlock
AIRLOCK_SECURITY_PROFILE=NONE
MURPH_NODE_ID=local
ZENOH_ROUTER=
UNS_MQTT_BROKER=
UNS_MQTT_CLIENT_ID=underhill-uns-publisher
UNS_MQTT_USERNAME=
UNS_MQTT_PASSWORD=
RUST_LOG=info

# Continuous plant runtime
# 1.0 is live wall-clock operation; values above 1 run fixed physics steps faster.
UNDERHILL_TIME_SCALE=1.0
# Host scheduler wake-up period. Physics always advances in deterministic 50 ms steps.
UNDERHILL_WALL_TICK_MS=50
# Deterministic medium/slow cadence boundaries for future subsystem tiers.
UNDERHILL_MEDIUM_PERIOD_SEC=1.0
UNDERHILL_SLOW_PERIOD_SEC=60.0
# Bounds work per host tick while retaining excess simulated time as catch-up backlog.
UNDERHILL_MAX_STEPS_PER_WALL_TICK=2000

# Durable continuous-plant identity and state. Keep the plant ID stable across upgrades.
UNDERHILL_PLANT_ID=underhill-base-primary
UNDERHILL_STATE_DIR=backend/data/continuous
# Simulated seconds between atomic full-state checkpoints.
UNDERHILL_CHECKPOINT_INTERVAL_SEC=60
# Canonical operation catches up elapsed wall time after restart. Validation forks may freeze.
UNDERHILL_DOWNTIME_POLICY=catch_up
# Refuse automatic catch-up beyond seven Earth days; require an operator recovery decision.
UNDERHILL_MAX_DOWNTIME_CATCHUP_SEC=604800

# launch script behavior
AIRLOCK_NONINTERACTIVE=0
AIRLOCK_AUTO_KILL_PORT=0
